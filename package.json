{
  "name": "aipaf-backend",
  "version": "1.0.0",
  "private": true,
  "description": "African Institute of Project Assurance and Forensics API backend",
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "start": "node server.mjs",
    "test:backend": "node --test test/backend.test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "cms:add-downloads": "node scripts/add-downloads-to-cms.mjs",
    "import:invitations": "node scripts/import-member-invitations.mjs",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "pg": "^8.13.0",
    "nodemailer": "^6.9.7"
  }
}
